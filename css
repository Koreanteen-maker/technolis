
:root{--orange:#ff5a00;--orange2:#ff7a1a;--black:#0a0a0a;--dark:#141414;--white:#fff;--bg:#f4f4f2;--muted:#777;--line:#e5e5e5;--shadow:0 18px 55px rgba(0,0,0,.10);--r:22px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:#151515;background:radial-gradient(circle at 10% 0,#fff 0,#f7f7f5 32%,#ededeb 100%);line-height:1.45}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.28;background-image:linear-gradient(135deg,rgba(255,90,0,.035) 25%,transparent 25%),linear-gradient(315deg,rgba(255,90,0,.025) 25%,transparent 25%);background-size:70px 70px;z-index:-1}a{text-decoration:none;color:inherit}button,input,select,textarea{font:inherit}.container{width:min(1180px,92%);margin:auto}
.header{position:sticky;top:0;z-index:1000;background:rgba(10,10,10,.97);border-bottom:2px solid var(--orange);box-shadow:0 6px 30px rgba(0,0,0,.18)}.head{height:78px;display:flex;align-items:center;gap:18px}.brand{display:flex;align-items:center;gap:11px}.logo{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#fff;border:2px solid var(--orange);box-shadow:0 0 0 3px rgba(255,90,0,.12)}.brand strong{font-size:20px;color:#fff;letter-spacing:.2px}.brand strong span{color:var(--orange)}.nav{margin-left:auto;display:flex;align-items:center;gap:20px}.nav a{color:#d6d6d6;font-size:13px;font-weight:800}.nav a:hover,.nav a.active{color:var(--orange)}.call{display:inline-flex;align-items:center;gap:8px;background:var(--orange);color:#fff;padding:13px 17px;border-radius:12px;font-weight:900;white-space:nowrap}.call svg{width:19px;height:19px;fill:#fff}.burger{display:none;margin-left:auto;background:#202020;border:1px solid #333;color:#fff;border-radius:11px;width:45px;height:45px;font-size:23px}
.hero{padding:86px 0 72px;overflow:hidden;position:relative}.hero:after{content:"";position:absolute;right:-160px;top:-180px;width:560px;height:560px;border-radius:50%;background:radial-gradient(circle,#ff5a001c,transparent 65%);pointer-events:none}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:55px;align-items:center}.eyebrow{color:var(--orange);font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:1.7px;margin-bottom:14px}.hero h1{font-size:clamp(48px,7.3vw,86px);line-height:.9;letter-spacing:-4px;margin:0;max-width:820px}.hero h1 span,.page-head h1 span{color:var(--orange)}.hero p{font-size:19px;color:#696969;max-width:680px;margin:25px 0 30px}.actions{display:flex;gap:12px;flex-wrap:wrap}.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;min-height:52px;padding:0 21px;border:0;border-radius:12px;font-weight:900;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-2px)}.orange{background:var(--orange);color:#fff}.black{background:#0a0a0a;color:#fff}.white{background:#fff;border:1px solid var(--line)}.hero-card{background:linear-gradient(145deg,#121212,#050505);color:#fff;border-radius:30px;padding:32px;box-shadow:var(--shadow);position:relative;overflow:hidden}.hero-card:before{content:"";position:absolute;width:240px;height:240px;background:var(--orange);border-radius:50%;right:-120px;top:-120px;opacity:.18}.hero-card h2{margin:0 0 20px;font-size:31px}.quick{display:grid;gap:10px}.quick a{display:flex;gap:12px;align-items:center;padding:15px;border:1px solid #292929;border-radius:15px;background:#101010}.quick a:hover{border-color:#ff5a00}.quick i{font-style:normal;font-size:23px}.quick b{display:block}.quick small{display:block;color:#999;margin-top:2px}.section{padding:78px 0}.section-head{margin-bottom:32px}.section-head h2{margin:0;font-size:clamp(34px,5vw,54px);letter-spacing:-2px;line-height:1}.section-head p{color:var(--muted);max-width:690px;margin:13px 0 0}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.card{background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:var(--r);padding:25px;box-shadow:0 7px 25px rgba(0,0,0,.045);transition:.2s}.card:hover{transform:translateY(-4px);border-color:#ffb38b;box-shadow:var(--shadow)}.icon{width:50px;height:50px;border-radius:14px;background:#fff0e8;display:grid;place-items:center;font-size:24px;margin-bottom:17px}.card h3{margin:0 0 8px;font-size:18px}.card p{margin:0;color:#777;font-size:14px}.link{display:inline-block;margin-top:17px;color:var(--orange);font-weight:900;font-size:14px}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-top:34px}.fact{display:flex;gap:10px;align-items:center}.fact-icon{width:42px;height:42px;display:grid;place-items:center;background:#fff;border-radius:12px}.fact b{font-size:12px;display:block}.fact span{font-size:11px;color:#777}
.page-head{padding:75px 0 52px;background:linear-gradient(120deg,#fff,#f0f0ee)}.page-head h1{font-size:clamp(45px,6.5vw,75px);line-height:.94;letter-spacing:-3px;margin:0}.page-head p{max-width:720px;color:#707070;font-size:18px;margin:20px 0 0}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.cta{margin-top:30px;background:#0a0a0a;color:#fff;border-radius:24px;padding:30px;display:flex;align-items:center;justify-content:space-between;gap:20px}.cta h3{margin:0 0 5px;font-size:26px}.cta p{margin:0;color:#999}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}.tab{border:1px solid #ddd;background:#fff;border-radius:11px;padding:12px 16px;font-weight:900;cursor:pointer}.tab.active{background:var(--orange);border-color:var(--orange);color:#fff}.price-box{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.05)}.price-title{background:#0a0a0a;color:#fff;padding:17px 20px;font-weight:900;font-size:18px}.price-title span{color:var(--orange)}.price-row{display:grid;grid-template-columns:1fr 180px;gap:20px;padding:17px 20px;border-bottom:1px solid var(--line)}.price-row:last-child{border-bottom:0}.price{font-weight:900;color:var(--orange);text-align:right}.note{margin-top:15px;padding:16px 18px;border-radius:13px;background:#fff2e9;color:#704b38}.price-cta{margin-top:28px;text-align:center}
.form-layout{display:grid;grid-template-columns:1fr 340px;gap:20px;align-items:start}.form{background:#fff;border:1px solid var(--line);border-radius:24px;padding:29px;box-shadow:var(--shadow)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:13px;font-weight:900}.field input,.field select,.field textarea{width:100%;border:1px solid #d8d8d8;border-radius:12px;padding:14px 15px;outline:0;background:#fff}.field textarea{min-height:130px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--orange);box-shadow:0 0 0 3px #ff5a0018}.side{background:#0a0a0a;color:#fff;border-radius:24px;padding:28px}.side h3{font-size:25px;margin:0 0 10px}.side p{color:#999}.side ul{list-style:none;padding:0;margin:20px 0 0;display:grid;gap:12px;color:#ddd}.notice{display:none;margin-top:14px;padding:14px;border-radius:12px;background:#e9f8ef;color:#146b38;font-weight:800}
.info-grid{display:grid;grid-template-columns:360px 1fr;gap:22px}.info{background:#fff;border:1px solid var(--line);border-radius:24px;padding:28px;box-shadow:var(--shadow)}.info h2{margin:0 0 22px;font-size:33px}.info-item{margin:0 0 19px}.info-item small{display:block;color:#777;margin-bottom:4px}.info-item strong{line-height:1.5}.info-item a{color:var(--orange)}.map{border-radius:24px;overflow:hidden;border:1px solid #ddd;min-height:470px;background:#ddd}.map iframe{width:100%;height:100%;min-height:470px;border:0}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.footer{background:#0a0a0a;color:#fff;padding:50px 0 25px;margin-top:30px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:35px}.footer p{color:#888;max-width:360px}.footer h3{margin:0 0 13px}.footer a{display:block;color:#aaa;margin:9px 0}.footer a:hover{color:var(--orange)}.copy{border-top:1px solid #262626;margin-top:30px;padding-top:18px;color:#666;font-size:12px}.mobilebar{display:none}
@media(max-width:1000px){.nav{gap:12px}.nav a{font-size:12px}.cards,.service-grid{grid-template-columns:repeat(2,1fr)}.hero-grid{grid-template-columns:1fr}.facts{grid-template-columns:repeat(2,1fr)}.form-layout{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}.map{min-height:380px}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:720px){body{padding-bottom:66px}.head{height:68px}.logo{width:50px;height:50px}.brand strong{display:none}.nav{display:none}.burger{display:block}.call{width:46px;height:46px;padding:0;border-radius:50%;margin-left:0}.call span{display:none}.hero{padding:58px 0 52px}.hero h1{font-size:51px;letter-spacing:-3px}.hero p{font-size:17px}.hero-card{padding:25px}.section{padding:60px 0}.cards,.service-grid{grid-template-columns:1fr 1fr;gap:10px}.card{padding:19px}.card h3{font-size:15px}.card p{font-size:12px}.facts{gap:14px 7px}.fact b{font-size:10px}.fact span{font-size:9px}.page-head{padding:58px 0 43px}.page-head h1{font-size:47px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.price-row{grid-template-columns:1fr 120px;padding:15px;font-size:13px}.cta{display:block}.cta .btn{margin-top:18px;width:100%}.contact-grid{grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.mobilebar{display:grid;position:fixed;bottom:0;left:0;right:0;height:66px;z-index:2000;background:#0a0a0a;border-top:2px solid var(--orange);grid-template-columns:1fr 1fr}.mobilebar a{display:flex;justify-content:center;align-items:center;color:#fff;font-weight:900;font-size:13px}.mobilebar a:first-child{background:var(--orange)}}
@media(max-width:390px){.cards,.service-grid{grid-template-columns:1fr}.hero h1{font-size:44px}}
@media(max-width:720px){.nav.mobile-open{display:flex;position:absolute;top:68px;left:0;right:0;background:#0a0a0a;flex-direction:column;align-items:stretch;padding:12px 5%;border-bottom:2px solid var(--orange)}.nav.mobile-open a{padding:12px 0;font-size:14px}}
